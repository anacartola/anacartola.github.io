---
import { type Locale } from "../i18n";
import { useTranslations } from "../i18n/utils";
import Icon from "./icons/Icon.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();

// Only the three mascots, centred (per the brand footer).
const mascots = [
  { name: "IconsCartolaPersonagensBirdStyleOutline" as const, label: "Corvo" },
  { name: "IconsCartolaPersonagensDogStyleOutline" as const, label: "Beagle" },
  { name: "IconsCartolaPersonagensFireflyBugStyleOutline" as const, label: "Vaga-lume" },
];
---

<footer class="ftr">
  <div class="ftr__mascots">
    {
      mascots.map((m) => (
        <span class="ftr__mascot">
          <Icon name={m.name} size={34} />
          <small>{m.label}</small>
        </span>
      ))
    }
  </div>
  <p class="ftr__meta">© {year} {t.site.fullName} · {t.footer.builtWith}</p>
</footer>

<style>
  .ftr {
    margin-top: var(--space-12);
    padding-block: var(--space-8) var(--space-5);
    border-top: 2px solid var(--frame-default);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    text-align: center;
  }
  .ftr__mascots {
    display: flex;
    justify-content: center;
    gap: var(--space-8);
  }
  .ftr__mascot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    color: var(--frame-default);
  }
  .ftr__mascot small {
    font: var(--type-caption);
    color: var(--text-muted);
  }
  .ftr__meta {
    margin: 0;
    font: var(--type-caption);
    color: var(--text-muted);
    max-width: none;
  }
</style>
