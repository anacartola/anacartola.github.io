---
import { LOCALES, LOCALE_NAMES, type Locale } from "../i18n";
import { useTranslations, localizedPath } from "../i18n/utils";
import Icon from "./icons/Icon.astro";

interface Props {
  locale: Locale;
  route: string;
  availableLocales?: readonly Locale[];
}
const { locale, route, availableLocales } = Astro.props;
const t = useTranslations(locale);
---

<details class="lang-switch">
  <summary aria-label={t.language.switch}>
    <span class="lang-switch__label">{LOCALE_NAMES[locale]}</span>
    <span class="lang-switch__arrow" aria-hidden="true">
      <Icon name="IconsProductNavigationArrowDownStyleOutline" size={10} />
    </span>
  </summary>
  <ul class="lang-switch__menu" role="list">
    {
      LOCALES.map((loc) => {
        const available = !availableLocales || availableLocales.includes(loc);
        return (
          <li>
            <a
              href={localizedPath(route, loc)}
              hreflang={loc}
              class:list={["lang-switch__item", loc === locale && "is-current"]}
              aria-current={loc === locale ? "true" : undefined}
            >
              <span>{LOCALE_NAMES[loc]}</span>
              {!available && (
                <span class="lang-switch__na">
                  {t.language.notAvailable} {loc.toUpperCase()}
                </span>
              )}
            </a>
          </li>
        );
      })
    }
  </ul>
</details>

<style>
  .lang-switch {
    position: relative;
    font: var(--type-label);
    letter-spacing: var(--tracking-label);
  }
  .lang-switch summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border: var(--stroke-default, 1px) solid var(--border-soft);
    color: var(--text-muted);
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition:
      color var(--dur-fast) var(--ease-std),
      border-color var(--dur-fast) var(--ease-std);
  }
  .lang-switch summary::-webkit-details-marker {
    display: none;
  }
  .lang-switch summary:hover,
  .lang-switch[open] summary {
    color: var(--frame-accent);
    border-color: var(--frame-accent);
  }
  .lang-switch__arrow {
    display: inline-flex;
    align-items: center;
    transition: transform var(--dur-fast) var(--ease-std);
  }
  .lang-switch[open] .lang-switch__arrow {
    transform: rotate(180deg);
  }
  .lang-switch__menu {
    position: absolute;
    right: 0;
    top: calc(100% + 4px);
    z-index: 50;
    margin: 0;
    padding: var(--inset-gap, 4px);
    list-style: none;
    min-width: 10rem;
    background: var(--surface-card);
    border: var(--stroke-default, 1px) solid var(--border-soft);
  }
  .lang-switch__item {
    display: flex;
    flex-direction: column;
    padding: 8px 10px;
    text-decoration: none;
    font: var(--type-body-sm);
    color: var(--text-body);
    transition:
      background var(--dur-fast) var(--ease-std),
      color var(--dur-fast) var(--ease-std);
  }
  .lang-switch__item:hover,
  .lang-switch__item:focus-visible {
    background: var(--interactive-inner-hover);
    color: var(--frame-accent);
  }
  .lang-switch__item.is-current {
    color: var(--text-heading);
    font-weight: 600;
  }
  .lang-switch__na {
    font: var(--type-caption);
    color: var(--text-muted);
  }
</style>
