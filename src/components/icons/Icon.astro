---
import { ICONS, type IconName } from "./data";

/**
 * Renders a design-system glyph by name. Single-colour, paints currentColor.
 * Only the subset in ./data.ts is bundled (not the full 122-icon set).
 */
interface Props {
  name: IconName;
  size?: number;
  title?: string;
  class?: string;
}
const { name, size = 24, title, class: className } = Astro.props;
const glyph = ICONS[name];
---

{
  glyph && (
    <svg
      width={size}
      height={size}
      viewBox={glyph.viewBox}
      fill="currentColor"
      role={title ? "img" : undefined}
      aria-hidden={title ? undefined : "true"}
      class={className}
      set:html={(title ? `<title>${title}</title>` : "") + glyph.body}
    />
  )
}
