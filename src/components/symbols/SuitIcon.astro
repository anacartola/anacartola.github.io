---
import { ICONS } from "../icons/data";

/**
 * Suit glyph — the brand categorisation system. Uses the design-system suit
 * icons (fill style). spades Analytics · diamonds Business · hearts Research ·
 * clubs Engineering. Paints currentColor. API preserved: suit, size, label.
 */
type Suit = "spades" | "diamonds" | "hearts" | "clubs";
interface Props {
  suit: Suit;
  size?: number;
  label?: string;
  class?: string;
}
const { suit, size = 16, label, class: className } = Astro.props;

const NAME: Record<Suit, keyof typeof ICONS> = {
  spades: "IconsCartolaNaipesSpadeStyleFill",
  diamonds: "IconsCartolaNaipesDiamondStyleFill",
  hearts: "IconsCartolaNaipesHeartStyleFill",
  clubs: "IconsCartolaNaipesCloverStyleFill",
};
const glyph = ICONS[NAME[suit]];
---

<svg
  width={size}
  height={size}
  viewBox={glyph.viewBox}
  fill="currentColor"
  role={label ? "img" : undefined}
  aria-hidden={label ? undefined : "true"}
  class={className}
  set:html={(label ? `<title>${label}</title>` : "") + glyph.body}
/>
