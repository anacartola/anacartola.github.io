---
import type { Localized } from "../lib/content";
import type { ResourceEntry } from "../lib/resources";
import { type Locale } from "../i18n";
import { useTranslations, localizedPath } from "../i18n/utils";
import Card from "./Card.astro";
import Badge from "./Badge.astro";

interface Props {
  item: Localized<ResourceEntry>;
  locale: Locale;
}
const { item, locale } = Astro.props;
const { entry, slug, isFallback, lang } = item;
const t = useTranslations(locale);
const data = entry.data;
const href = localizedPath(`/resources/${slug}`, locale);
---

<Card variant={data.featured ? "highlight" : "default"} href={href} class="resource-card">
  <div class="resource-card__head">
    {data.suit
      ? <Badge suit={data.suit} icon label={t.resources.kind[data.kind]} />
      : <Badge label={t.resources.kind[data.kind]} />}
    <span class={`status status--${data.status}`}>{t.resources.status[data.status]}</span>
    {
      isFallback && (
        <span class="na-badge">
          {t.language.notAvailable} {locale.toUpperCase()} · {lang.toUpperCase()}
        </span>
      )
    }
  </div>

  <h3 class="resource-card__title">{data.title}</h3>
  <p class="resource-card__summary">{data.summary}</p>

  {
    data.tags.length > 0 && (
      <ul class="resource-card__tags" role="list">
        {data.tags.slice(0, 5).map((tag) => <li><Badge label={tag} /></li>)}
      </ul>
    )
  }
</Card>

<style>
  .resource-card__head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }
  .status {
    font-size: var(--fs-caption);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border: var(--border-w) solid var(--border);
  }
  .status--live { color: var(--accent); border-color: var(--accent); }
  .status--beta { color: var(--text-detail); }
  .status--wip { color: var(--text-muted); }
  .na-badge {
    font-size: var(--fs-caption);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-left: auto;
  }
  .resource-card__title { margin: 0 0 var(--space-2); }
  .resource-card__summary { margin: 0 0 var(--space-4); color: var(--text); max-width: none; }
  .resource-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
