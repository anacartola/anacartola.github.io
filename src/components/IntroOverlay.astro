---
/**
 * Typewriter intro — types "Ana Cartola" → deletes → types "A. Cartola",
 * then fades out. Fires every time the home page loads.
 */
---

<div class="intro" id="ac-intro" aria-hidden="true">
  <svg class="intro-mark" width="40" height="61" viewBox="0 0 673.684 1024" fill="currentColor" aria-hidden="true">
    <path d="M 490.888 387.526 C 599.444 443.45 673.684 556.634 673.684 687.158 C 673.684 873.191 522.874 1024 336.842 1024 C 150.809 1024 0 873.191 0 687.158 C 0 556.634 74.239 443.45 182.795 387.526 L 0 0 L 673.684 0 L 490.888 387.526 Z M 336.847 296.421 C 298.003 296.421 261.358 305.849 229.053 322.537 L 328.321 533.53 C 331.722 540.752 341.971 540.752 345.372 533.53 L 444.632 322.537 C 412.328 305.851 375.687 296.421 336.847 296.421 Z" fill-rule="nonzero"/>
  </svg>
  <span class="intro-word" id="ac-intro-word"><span class="intro-caret"></span></span>
</div>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 99;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    background: var(--surface-page);
    transition: opacity 0.5s ease;
  }
  .intro.out {
    opacity: 0;
    pointer-events: none;
  }
  .intro-mark {
    color: var(--logo-ink, var(--frame-accent));
  }
  .intro-word {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(34px, 7vw, 64px);
    letter-spacing: 0.02em;
    color: var(--logo-ink);
    line-height: 1;
    min-height: 1.1em;
    display: inline-flex;
    align-items: center;
  }
  .intro-caret {
    display: inline-block;
    width: 3px;
    height: 0.92em;
    margin-left: 6px;
    background: var(--frame-accent);
    animation: introblink 1s step-end infinite;
  }
  @keyframes introblink { 50% { opacity: 0; } }
</style>

<script is:inline>
  (function () {
    var el = document.getElementById("ac-intro");
    var word = document.getElementById("ac-intro-word");
    if (!el || !word) return;

    var A = "Ana Cartola", B = "A. Cartola";
    var steps = [];
    var i;
    for (i = 1; i <= A.length; i++) steps.push({ t: A.slice(0, i), d: 85 });
    steps.push({ t: A, d: 650 });
    for (i = A.length - 1; i >= 0; i--) steps.push({ t: A.slice(0, i), d: 45 });
    for (i = 1; i <= B.length; i++) steps.push({ t: B.slice(0, i), d: 100 });
    steps.push({ t: B, d: 850 });

    var idx = 0;
    function run() {
      if (idx >= steps.length) {
        el.classList.add("out");
        setTimeout(function () { el.remove(); }, 550);
        return;
      }
      var s = steps[idx++];
      word.innerHTML = s.t + '<span class="intro-caret"></span>';
      setTimeout(run, s.d);
    }
    setTimeout(run, 350);
  })();
</script>
