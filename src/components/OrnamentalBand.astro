---
import Icon from "./icons/Icon.astro";

/**
 * Ornamental band — Art Déco separator (blue-900) with a row of star-flares
 * (hero -> cards divider). Decorative. Twinkle is disabled under
 * prefers-reduced-motion (handled globally in global.css).
 */
interface Props {
  count?: number;
  class?: string;
}
const { count = 7, class: className } = Astro.props;
const sizes = Array.from({ length: count }, (_, i) => (i % 2 === 0 ? 22 : 14));
---

<div class:list={["ac-band", className]} aria-hidden="true">
  {
    sizes.map((s, i) => (
      <span class="ac-band__flare" style={`--i:${i}`}>
        <Icon name="IconsProductStatusStarFlareStyleFill" size={s} />
      </span>
    ))
  }
</div>

<style>
  .ac-band {
    background: var(--blue-900);
    color: var(--blue-300);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    padding: var(--space-4);
    overflow: hidden;
  }
  .ac-band__flare {
    display: inline-flex;
    opacity: 0.5;
    animation: ac-flare 3.2s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.3s);
  }
  @keyframes ac-flare {
    0%,
    100% { opacity: 0.3; transform: scale(0.9); }
    50% { opacity: 0.95; transform: scale(1.08); }
  }
</style>
