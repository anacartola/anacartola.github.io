---
import { type Locale } from "../i18n";
import { useTranslations, localizedPath } from "../i18n/utils";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";
import Icon from "./icons/Icon.astro";

interface Props {
  locale: Locale;
  /** Canonical route (locale-stripped) of the current page. */
  route: string;
}
const { locale, route } = Astro.props;
const t = useTranslations(locale);

const items = [
  { href: "/", label: t.nav.home },
  { href: "/projects", label: t.nav.projects },
  { href: "/blog", label: t.nav.blog },
  { href: "/resources", label: t.nav.resources },
  { href: "/about", label: t.nav.about },
  { href: "/contact", label: t.nav.contact },
];
const isActive = (r: string) =>
  route === r || (r !== "/" && route.startsWith(r + "/"));
---

<header class="brandhdr">
  <div class="brandhdr__top">
    <a class="brandhdr__name" href={localizedPath("/", locale)}>{t.site.author}</a>
    <div class="brandhdr__tools">
      <LanguageSwitcher locale={locale} route={route} />
      <ThemeToggle locale={locale} />
    </div>
  </div>

  <nav class="brandhdr__nav" aria-label={t.nav.menu}>
    <span class="caret" aria-hidden="true">
      <Icon name="IconsProductMediaPlayStyleOutline" size={14} />
    </span>
    <ul role="list">
      {
        items.map((item) => (
          <li>
            <a
              href={localizedPath(item.href, locale)}
              class:list={["brandhdr__link", isActive(item.href) && "is-active"]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <span class="caret" aria-hidden="true">
      <Icon name="IconsProductMediaSkipBackStyleOutline" size={14} />
    </span>
  </nav>

  <div class="brandhdr__rule" aria-hidden="true"></div>
</header>

<style>
  .brandhdr {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    /* top padding clears the crowned cartola hanging from the frame top */
    padding: 44px 0 14px;
  }
  .brandhdr__top {
    display: contents;
  }
  .brandhdr__tools {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .brandhdr__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 40px;
    letter-spacing: 0.02em;
    color: var(--text-body);
    line-height: 1;
    text-decoration: none;
  }
  .brandhdr__name:hover {
    color: var(--frame-accent);
  }
  .brandhdr__nav {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-1);
  }
  .brandhdr__nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
    flex-wrap: wrap;
    justify-content: center;
  }
  .caret {
    display: inline-flex;
    align-items: center;
    color: var(--frame-accent);
    flex-shrink: 0;
    margin: 0 6px;
  }
  .brandhdr__link {
    /* inactive links use the lower-contrast secondary colour */
    font: var(--type-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
    padding: 6px 10px;
    border-bottom: 2px solid transparent;
    transition:
      color var(--dur-fast) var(--ease-std),
      border-color var(--dur-fast) var(--ease-std);
  }
  .brandhdr__link:hover,
  .brandhdr__link:focus-visible {
    color: var(--frame-accent);
    border-color: var(--frame-accent);
  }
  /* the active (current) item is the high-contrast one */
  .brandhdr__link.is-active {
    color: var(--text-body);
    border-color: var(--text-body);
  }
  .brandhdr__rule {
    width: 100%;
    max-width: 560px;
    height: 2px;
    background: var(--frame-default);
    margin-top: var(--space-2);
  }

  @media (max-width: 640px) {
    .brandhdr {
      position: sticky;
      top: 0;
      z-index: 50;
      background: var(--surface-page);
      padding: var(--space-2) 0 0;
      gap: var(--space-1);
      align-items: stretch;
    }
    .brandhdr__top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }
    .brandhdr__tools {
      position: static;
      margin-bottom: 0;
    }
    .brandhdr__name {
      font-size: clamp(18px, 5vw, 26px);
      white-space: nowrap;
    }
    .brandhdr__nav {
      flex-wrap: nowrap;
      width: 100%;
    }
    .brandhdr__nav ul {
      flex-wrap: nowrap;
      overflow-x: auto;
      min-width: 0;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .brandhdr__nav ul::-webkit-scrollbar {
      display: none;
    }
    .brandhdr__rule {
      max-width: none;
    }
  }
</style>
