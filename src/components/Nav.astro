---
import { type Locale } from "../i18n";
import { useTranslations, localizedPath } from "../i18n/utils";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";
import Icon from "./icons/Icon.astro";

interface Props {
  locale: Locale;
  /** Canonical route (locale-stripped) of the current page. */
  route: string;
}
const { locale, route } = Astro.props;
const t = useTranslations(locale);

const items = [
  { href: "/", label: t.nav.home },
  { href: "/projects", label: t.nav.projects },
  { href: "/blog", label: t.nav.blog },
  { href: "/resources", label: t.nav.resources },
  { href: "/about", label: t.nav.about },
  { href: "/contact", label: t.nav.contact },
];
const isActive = (r: string) =>
  route === r || (r !== "/" && route.startsWith(r + "/"));
---

<header class="brandhdr">
  <div class="brandhdr__crown-wrap" aria-hidden="true">
    <svg width="30" height="45" viewBox="0 0 673.684 1024" fill="var(--frame-default)">
      <path d="M 490.888 387.526 C 599.444 443.45 673.684 556.634 673.684 687.158 C 673.684 873.191 522.874 1024 336.842 1024 C 150.809 1024 0 873.191 0 687.158 C 0 556.634 74.239 443.45 182.795 387.526 L 0 0 L 673.684 0 L 490.888 387.526 Z M 336.847 296.421 C 298.003 296.421 261.358 305.849 229.053 322.537 L 328.321 533.53 C 331.722 540.752 341.971 540.752 345.372 533.53 L 444.632 322.537 C 412.328 305.851 375.687 296.421 336.847 296.421 Z" fill-rule="nonzero"/>
    </svg>
  </div>
  <a class="brandhdr__name" href={localizedPath("/", locale)}>{t.site.author}</a>

  <div class="brandhdr__tools">
    <LanguageSwitcher locale={locale} route={route} />
    <ThemeToggle locale={locale} />
  </div>

  <nav class="brandhdr__nav" aria-label={t.nav.menu}>
    <button class="caret" type="button" data-dir="-1">
      <Icon name="IconsProductMediaSkipBackStyleOutline" size={14} />
    </button>
    <ul role="list">
      {
        items.map((item) => (
          <li>
            <a
              href={localizedPath(item.href, locale)}
              class:list={["brandhdr__link", isActive(item.href) && "is-active"]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <button class="caret" type="button" data-dir="1">
      <Icon name="IconsProductMediaPlayStyleOutline" size={14} />
    </button>
  </nav>

  <div class="brandhdr__rule" aria-hidden="true"></div>
</header>

<style>
  .brandhdr {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    /* top padding clears the crowned cartola hanging from the frame top */
    padding: 44px 0 14px;
  }
  .brandhdr__tools {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .brandhdr__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 40px;
    letter-spacing: 0.02em;
    color: var(--logo-ink);
    line-height: 1;
    text-decoration: none;
  }
  .brandhdr__name:hover {
    color: var(--frame-accent);
  }
  .brandhdr__nav {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-1);
  }
  .brandhdr__nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
    flex-wrap: wrap;
    justify-content: center;
  }
  .caret {
    display: inline-flex;
    align-items: center;
    color: var(--frame-accent);
    flex-shrink: 0;
    margin: 0 6px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .brandhdr__link {
    /* inactive links use the lower-contrast secondary colour */
    font: var(--type-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
    padding: 6px 10px;
    border-bottom: 2px solid transparent;
    transition:
      color var(--dur-fast) var(--ease-std),
      border-color var(--dur-fast) var(--ease-std);
  }
  .brandhdr__link:hover,
  .brandhdr__link:focus-visible {
    color: var(--frame-accent);
    border-color: var(--frame-accent);
  }
  :global([data-theme="dark"]) .brandhdr__link:hover,
  :global([data-theme="dark"]) .brandhdr__link:focus-visible {
    color: var(--orange-500);
    border-color: var(--orange-500);
  }
  /* the active (current) item is the high-contrast one */
  .brandhdr__link.is-active {
    color: var(--text-body);
    border-color: var(--text-body);
  }
  .brandhdr__crown-wrap { display: none; }
  .brandhdr__rule {
    width: 100%;
    max-width: 560px;
    height: 2px;
    background: var(--frame-default);
    margin-top: var(--space-2);
  }

  @media (max-width: 768px) {
    .brandhdr {
      position: sticky;
      top: 0;
      z-index: 5;
      background: var(--surface-page);
      padding: 8px clamp(16px, 4vw, 34px) 0;
      margin-left: calc(-1 * clamp(16px, 4vw, 34px));
      margin-right: calc(-1 * clamp(16px, 4vw, 34px));
      gap: var(--space-2);
    }
    .brandhdr__crown-wrap {
      display: flex;
      justify-content: center;
      opacity: 0;
      transform: translateY(-6px) scale(1.33);
      transition: opacity 0.25s ease, transform 0.25s ease;
    }
    .brandhdr__crown-wrap.is-visible {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    .brandhdr__name {
      font-size: clamp(22px, 6vw, 32px);
    }
    .brandhdr__tools {
      position: static;
      justify-content: center;
      gap: var(--space-4);
      margin-bottom: var(--space-1);
    }
    .brandhdr__nav {
      flex-wrap: nowrap;
      width: 100%;
      margin-top: 0;
    }
    .brandhdr__nav ul {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      min-width: 0;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      mask-image: linear-gradient(
        to right, black calc(100% - 24px), transparent
      );
      -webkit-mask-image: linear-gradient(
        to right, black calc(100% - 24px), transparent
      );
    }
    .brandhdr__nav ul::-webkit-scrollbar {
      display: none;
    }
    .brandhdr__link {
      white-space: nowrap;
    }
    .brandhdr__rule {
      max-width: none;
    }
  }
</style>

<script>
  const frameCrown = document.querySelector('.acdf-crown');
  const hdrCrown = document.querySelector('.brandhdr__crown-wrap');
  if (frameCrown && hdrCrown) {
    const crownExit = frameCrown.getBoundingClientRect().bottom + window.scrollY - 15;
    let showing = false;
    window.addEventListener('scroll', () => {
      const show = window.scrollY > crownExit;
      if (show !== showing) {
        showing = show;
        hdrCrown.classList.toggle('is-visible', show);
      }
    }, { passive: true });
  }

  document.querySelectorAll<HTMLButtonElement>('.caret[data-dir]').forEach(btn => {
    btn.addEventListener('click', () => {
      const ul = btn.closest('.brandhdr__nav')?.querySelector('ul');
      if (ul) {
        ul.scrollBy({ left: parseInt(btn.dataset.dir!) * 150, behavior: 'smooth' });
      }
    });
  });
</script>
