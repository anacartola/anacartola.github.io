---
import { type Locale } from "../i18n";
import { useTranslations, localizedPath } from "../i18n/utils";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
  /** Canonical route (locale-stripped) of the current page. */
  route: string;
}
const { locale, route } = Astro.props;
const t = useTranslations(locale);

const items = [
  { href: "/", label: t.nav.home },
  { href: "/projects", label: t.nav.projects },
  { href: "/blog", label: t.nav.blog },
  { href: "/resources", label: t.nav.resources },
  { href: "/about", label: t.nav.about },
  { href: "/contact", label: t.nav.contact },
];
const isActive = (r: string) =>
  route === r || (r !== "/" && route.startsWith(r + "/"));
---

<header class="brandhdr">
  <div class="brandhdr__tools">
    <LanguageSwitcher locale={locale} route={route} />
    <ThemeToggle locale={locale} />
  </div>

  <a class="brandhdr__brand" href={localizedPath("/", locale)} aria-label={t.site.author}>
    <span class="brandhdr__mark" aria-hidden="true"></span>
    <span class="brandhdr__name">{t.site.author}</span>
  </a>

  <nav class="brandhdr__nav" aria-label={t.nav.menu}>
    <span class="brandhdr__arrow" aria-hidden="true">&#9658;</span>
    <ul role="list">
      {
        items.map((item) => (
          <li>
            <a
              href={localizedPath(item.href, locale)}
              class:list={["brandhdr__link", isActive(item.href) && "is-active"]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <span class="brandhdr__arrow" aria-hidden="true">&#9668;</span>
  </nav>

  <div class="brandhdr__rule" aria-hidden="true"></div>
</header>

<style>
  .brandhdr {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) 0 var(--space-4);
  }
  .brandhdr__tools {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .brandhdr__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
  }
  .brandhdr__mark {
    display: block;
    width: 30px;
    height: 46px;
    background: var(--logo-ink);
    -webkit-mask: url("/logo/cartola-outline.svg") no-repeat center / contain;
    mask: url("/logo/cartola-outline.svg") no-repeat center / contain;
  }
  .brandhdr__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 34px;
    letter-spacing: 0.02em;
    color: var(--text-body);
    line-height: 1;
  }
  .brandhdr__brand:hover .brandhdr__name {
    color: var(--frame-accent);
  }
  .brandhdr__nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    justify-content: center;
  }
  .brandhdr__nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
    flex-wrap: wrap;
    justify-content: center;
  }
  .brandhdr__arrow {
    color: var(--frame-default);
    font-size: 13px;
    padding: 0 var(--space-2);
  }
  .brandhdr__link {
    display: inline-flex;
    align-items: center;
    height: var(--control-h-tab);
    padding: 0 12px;
    font: 600 14px/1 var(--font-body);
    color: var(--interactive-text);
    text-decoration: none;
    border-bottom: var(--stroke-heavy) solid transparent;
    transition:
      color var(--dur-fast) var(--ease-std),
      border-color var(--dur-fast) var(--ease-std);
  }
  .brandhdr__link:hover,
  .brandhdr__link:focus-visible {
    color: var(--frame-accent);
    border-color: var(--frame-accent);
  }
  .brandhdr__link.is-active {
    color: var(--text-body);
    border-color: var(--frame-secondary);
  }
  .brandhdr__rule {
    width: 100%;
    max-width: 560px;
    height: 2px;
    background: var(--frame-secondary);
    margin-top: var(--space-1);
  }

  @media (max-width: 640px) {
    .brandhdr__tools {
      position: static;
      justify-content: center;
      margin-bottom: var(--space-2);
    }
    .brandhdr {
      padding-top: var(--space-3);
    }
  }
</style>
