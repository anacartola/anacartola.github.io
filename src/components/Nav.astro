---
import { type Locale } from "../i18n";
import { useTranslations, localizedPath } from "../i18n/utils";
import Cartola from "./symbols/Cartola.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
  /** Canonical route (locale-stripped) of the current page. */
  route: string;
}
const { locale, route } = Astro.props;
const t = useTranslations(locale);

const items = [
  { key: "home", href: "/", label: t.nav.home },
  { key: "projects", href: "/projects", label: t.nav.projects },
  { key: "blog", href: "/blog", label: t.nav.blog },
  { key: "about", href: "/about", label: t.nav.about },
  { key: "contact", href: "/contact", label: t.nav.contact },
];

const isActive = (r: string) =>
  route === r || (r !== "/" && route.startsWith(r + "/")) || (r !== "/" && route === r);
---

<header class="site-header">
  <div class="container site-header__row">
    <a href={localizedPath("/", locale)} class="brand" aria-label={t.site.author}>
      <Cartola size={30} />
      <span class="brand__name">{t.site.author}</span>
    </a>

    <details class="nav">
      <summary class="nav__toggle" aria-label={t.nav.menu}>
        <span class="nav__bar" aria-hidden="true"></span>
        <span class="nav__bar" aria-hidden="true"></span>
        <span class="nav__bar" aria-hidden="true"></span>
      </summary>
      <nav class="nav__panel" aria-label={t.nav.menu}>
        <ul class="nav__links" role="list">
          {
            items.map((item) => (
              <li>
                <a
                  href={localizedPath(item.href, locale)}
                  class:list={["nav__link", isActive(item.href) && "is-active"]}
                  aria-current={isActive(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>

    <div class="site-header__controls">
      <LanguageSwitcher locale={locale} route={route} />
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--border-w) solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 40;
  }
  .site-header__row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-detail);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
  }
  .brand:hover {
    color: var(--accent);
  }
  .brand__name {
    letter-spacing: 0.5px;
  }

  .nav {
    margin-left: auto;
  }
  .nav__toggle {
    display: none;
    list-style: none;
    cursor: pointer;
    width: 2.25rem;
    height: 2.25rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    border: var(--border-w) solid var(--border);
  }
  .nav__toggle::-webkit-details-marker {
    display: none;
  }
  .nav__bar {
    width: 18px;
    height: 2px;
    background: var(--text-detail);
  }

  .nav__links {
    display: flex;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav__link {
    text-decoration: none;
    color: var(--text);
    font-weight: 600;
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
    transition:
      color var(--transition),
      border-color var(--transition);
  }
  .nav__link:hover,
  .nav__link:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }
  .nav__link.is-active {
    color: var(--text-detail);
    border-color: var(--text-detail);
  }

  .site-header__controls {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* --- Desktop: links always visible (neutralise the <details> collapse) - */
  @media (min-width: 721px) {
    .nav__toggle {
      display: none;
    }
    /* Override the closed-<details> hiding so the menu shows regardless. */
    .nav__panel {
      display: block !important;
    }
  }

  /* --- Mobile: collapse links behind the toggle -------------------------- */
  @media (max-width: 720px) {
    .nav__toggle {
      display: flex;
    }
    .nav__panel {
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      background: var(--bg);
      border-bottom: var(--border-w) solid var(--border);
      padding: var(--space-4) var(--space-5);
    }
    .nav__links {
      flex-direction: column;
      gap: var(--space-4);
    }
    .nav[open] .nav__toggle {
      border-color: var(--accent);
    }
  }
</style>
