---
/**
 * DecoFrame — Art Déco page border that WRAPS content and grows with it
 * (never fixed). Ported 1:1 from the design system (prism variant, medallions
 * on the side edges). Geometry from Figma Border/Corner/Prism + Edge H|V +
 * Middle/Prism. Colour flows through `color` -> --fc.
 * API: `color` (default frame-default), `class`, slot.
 */
interface Props {
  color?: string;
  variant?: "prism" | "crowned";
  class?: string;
}
const {
  color = "var(--frame-default)",
  variant = "prism",
  class: className,
} = Astro.props;
const crowned = variant === "crowned";

// The cartola hat that breaks the top rule at centre (the brand signature).
const HAT =
  `<path d="M 490.888 387.526 C 599.444 443.45 673.684 556.634 673.684 687.158 C 673.684 873.191 522.874 1024 336.842 1024 C 150.809 1024 0 873.191 0 687.158 C 0 556.634 74.239 443.45 182.795 387.526 L 0 0 L 673.684 0 L 490.888 387.526 Z M 336.847 296.421 C 298.003 296.421 261.358 305.849 229.053 322.537 L 328.321 533.53 C 331.722 540.752 341.971 540.752 345.372 533.53 L 444.632 322.537 C 412.328 305.851 375.687 296.421 336.847 296.421 Z" fill-rule="nonzero"/>`;

const CORNER =
  `<path d="M 28 5 L 10 5 C 7.239 5 5 7.239 5 10 L 5 28 L 0 28 L 0 0 L 28 0 L 28 5 Z" fill-rule="nonzero"/>` +
  `<path d="M 0 5 C 0 2.239 2.239 0 5 0 L 5 5 L 0 5 Z" transform="translate(23,23)" fill-rule="nonzero"/>` +
  `<rect x="23" y="8" width="5" height="2"/><rect x="23" y="18" width="5" height="2"/>` +
  `<rect x="8" y="23" width="2" height="5"/><rect x="18" y="23" width="2" height="5"/>` +
  `<rect width="7" height="7" transform="matrix(0.707,-0.707,0.707,0.707,9.05,13.95)"/>`;
const MIDDLE =
  `<path d="M 28 0 L 28 28 L 0 28 L 0 23 L 18 23 C 20.761 23 23 20.761 23 18 L 23 10 C 23 7.239 20.761 5 18 5 L 0 5 L 0 0 L 28 0 Z" fill-rule="nonzero"/>` +
  `<path d="M 6 13.95 L 10.95 9 L 15.899 13.95 L 10.95 18.899 L 6 13.95 Z" fill-rule="nonzero"/>`;

const corners = [
  { pos: "tl", t: "scale(1,1)" },
  { pos: "tr", t: "scale(-1,1)" },
  { pos: "bl", t: "scale(1,-1)" },
  { pos: "br", t: "scale(-1,-1)" },
];
---

<div class:list={["acdf", className]} style={`--fc:${color}`}>
  <svg class="acdf-corner" width="28" height="28" viewBox="0 0 28 28" fill="var(--fc)" aria-hidden="true" style={`transform:${corners[0].t}`} set:html={CORNER} />
  <div class:list={["acdf-edge-h", crowned && "acdf-edge-h--crown"]}>
    <span class="acdf-h"></span>
    {crowned && <svg class="acdf-crown" width="40" height="60" viewBox="0 0 673.684 1024" fill="var(--fc)" aria-hidden="true" set:html={HAT} />}
    <span class="acdf-h"></span>
  </div>
  <svg class="acdf-corner" width="28" height="28" viewBox="0 0 28 28" fill="var(--fc)" aria-hidden="true" style={`transform:${corners[1].t}`} set:html={CORNER} />

  <div class="acdf-edge-v">
    <span class="acdf-v"></span>
    <svg class="acdf-mid" width="28" height="28" viewBox="0 0 28 28" fill="var(--fc)" aria-hidden="true" set:html={MIDDLE} />
    <span class="acdf-v"></span>
  </div>
  <div class="acdf-content"><slot /></div>
  <div class="acdf-edge-v flip">
    <span class="acdf-v"></span>
    <svg class="acdf-mid" width="28" height="28" viewBox="0 0 28 28" fill="var(--fc)" aria-hidden="true" set:html={MIDDLE} />
    <span class="acdf-v"></span>
  </div>

  <svg class="acdf-corner" width="28" height="28" viewBox="0 0 28 28" fill="var(--fc)" aria-hidden="true" style={`transform:${corners[2].t}`} set:html={CORNER} />
  <div class="acdf-edge-h flip">
    <span class="acdf-h"></span><span class="acdf-h"></span>
  </div>
  <svg class="acdf-corner" width="28" height="28" viewBox="0 0 28 28" fill="var(--fc)" aria-hidden="true" style={`transform:${corners[3].t}`} set:html={CORNER} />
</div>

<style>
  .acdf {
    display: grid;
    grid-template-columns: 28px 1fr 28px;
    grid-template-rows: 28px 1fr 28px;
    width: 100%;
    box-sizing: border-box;
  }
  .acdf-corner {
    display: block;
    transform-origin: center;
  }
  .acdf-h {
    height: 28px;
    flex: 1;
    min-width: 0;
    background-repeat: no-repeat;
    background-size: 100% 28px;
    background-image: linear-gradient(
      to bottom,
      var(--fc) 0 5px, transparent 5px 8px, var(--fc) 8px 10px,
      transparent 10px 18px, var(--fc) 18px 20px, transparent 20px 23px, var(--fc) 23px 28px
    );
  }
  .acdf-v {
    width: 28px;
    flex: 1;
    min-height: 0;
    background-repeat: no-repeat;
    background-size: 28px 100%;
    background-image: linear-gradient(
      to right,
      var(--fc) 0 5px, transparent 5px 8px, var(--fc) 8px 10px,
      transparent 10px 18px, var(--fc) 18px 20px, transparent 20px 23px, var(--fc) 23px 28px
    );
  }
  .acdf-edge-h {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 28px;
    overflow: visible;
  }
  .acdf-edge-v {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 28px;
    overflow: visible;
  }
  .acdf-edge-h.flip { transform: scaleY(-1); }
  .acdf-edge-v.flip { transform: scaleX(-1); }
  .acdf-mid { display: block; flex: none; }
  /* Crowned: the cartola breaks the top rule — brim flush with the outer line,
     round body hanging DOWN into the content. */
  .acdf-edge-h--crown { align-items: flex-start; gap: 24px; }
  .acdf-crown { position: relative; z-index: 3; flex: none; display: block; }
  .acdf-content {
    position: relative;
    min-width: 0;
    min-height: 0;
  }
</style>
