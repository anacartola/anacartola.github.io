---
/**
 * Card — corner-only Art Déco brackets (Component/Corner geometry from the DS).
 * The body is open; corners turn copper on hover (Highlight fixes them copper).
 * API preserved: `variant` (default|elevated|dark|highlight), `href`, `class`, slot.
 */
interface Props {
  variant?: "default" | "elevated" | "dark" | "highlight";
  href?: string;
  class?: string;
}
const { variant = "default", href, class: className } = Astro.props;
const Tag = href ? "a" : "div";
// Corner authored bottom-left; reflect to each vertex.
const corners = [
  { pos: "tl", t: "scale(1,-1)" },
  { pos: "tr", t: "scale(-1,-1)" },
  { pos: "bl", t: "scale(1,1)" },
  { pos: "br", t: "scale(-1,1)" },
];
---

<Tag
  class:list={["accard", `accard--${variant}`, href && "accard--link", className]}
  href={href}
>
  {
    corners.map((c) => (
      <svg
        class={`accard-corner accard-corner--${c.pos}`}
        width="22"
        height="22"
        viewBox="0 0 28 28"
        fill="currentColor"
        aria-hidden="true"
        style={`transform:${c.t};transform-origin:center`}
      >
        <g transform="translate(3,3)">
          <path d="M 5 12 C 5 14.761 7.239 17 10 17 L 22 17 L 22 22 L 0 22 L 0 0 L 5 0 L 5 12 Z" />
          <rect width="7" height="7" transform="matrix(0.707,0.707,-0.707,0.707,13.5,3.55)" />
        </g>
      </svg>
    ))
  }
  <div class="accard-body"><slot /></div>
</Tag>

<style>
  .accard {
    position: relative;
    box-sizing: border-box;
    display: block;
    padding: 28px;
    border-radius: 0;
    background: var(--surface-card);
    color: var(--text-body);
    text-decoration: none;
    --cc: var(--frame-default);
    transition:
      transform var(--dur-move) var(--ease-std),
      box-shadow var(--dur-move) var(--ease-std);
  }
  .accard--elevated {
    background: var(--surface-elevated);
    box-shadow: var(--shadow-raised);
  }
  .accard--dark {
    background: var(--surface-dark);
    color: var(--blue-50);
  }
  .accard--highlight {
    --cc: var(--orange-500);
  }

  .accard-corner {
    position: absolute;
    color: var(--cc);
    transition: color var(--dur-move) var(--ease-std);
  }
  .accard-corner--tl { top: 6px; left: 6px; }
  .accard-corner--tr { top: 6px; right: 6px; }
  .accard-corner--bl { bottom: 6px; left: 6px; }
  .accard-corner--br { bottom: 6px; right: 6px; }

  .accard-body { position: relative; }

  .accard--link:hover,
  .accard--link:focus-visible {
    transform: translateY(-2px);
  }
  .accard--default.accard--link:hover,
  .accard--elevated.accard--link:hover,
  .accard--dark.accard--link:hover,
  .accard--default.accard--link:focus-visible,
  .accard--elevated.accard--link:focus-visible,
  .accard--dark.accard--link:focus-visible {
    --cc: var(--orange-500);
  }
  .accard--link:focus-visible {
    outline: 2px solid var(--frame-accent);
    outline-offset: 3px;
  }
</style>
