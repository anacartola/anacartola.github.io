---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LOCALES, type Locale } from "../../i18n";
import { useTranslations } from "../../i18n/utils";
import { getProjectsForLocale } from "../../lib/content";
import { buildDeck } from "../../lib/deck";
import CardDeck from "../deck/CardDeck.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const projects = await getProjectsForLocale(locale);
const stacks = buildDeck(projects);
---

<BaseLayout
  locale={locale}
  route="/projects"
  title={`${t.projects.title} — ${t.site.author}`}
  description={t.meta.defaultDescription}
  availableLocales={LOCALES}
>
  <section class="container page-head">
    <h1>{t.projects.title}</h1>
    <p class="page-head__intro">{t.projects.intro}</p>
  </section>

  <section class="container">
    <CardDeck stacks={stacks} locale={locale} />
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--space-8) var(--space-4);
  }
  .page-head__intro {
    font-size: var(--fs-body-lg);
    color: var(--text-muted);
    max-width: 60ch;
  }
</style>
