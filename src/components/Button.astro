---
/**
 * Button — A. Cartola anatomy: square outer frame (padding = inset-gap) with an
 * inner rounded fill; hover shifts hue teal -> copper. Dark mode is derived by
 * token swap. Renders <a> when `href` is set, else <button>.
 * API preserved from the original scaffold: `href`, `variant`, `class`, slot.
 */
type Variant =
  | "primary"
  | "secondary"
  | "ghost"
  | "success"
  | "warning"
  | "danger"
  | "dark-primary";
interface Props {
  href?: string;
  variant?: Variant;
  size?: "md" | "sm";
  block?: boolean;
  type?: "button" | "submit";
  class?: string;
  [key: string]: any;
}
const {
  href,
  variant = "primary",
  size = "md",
  block = false,
  type = "button",
  class: className,
  ...rest
} = Astro.props;
const Tag = href ? "a" : "button";
---

<Tag
  class:list={[
    "acb",
    `acb-${variant}`,
    size === "sm" && "acb-sm",
    block && "acb-block",
    className,
  ]}
  href={href}
  type={href ? undefined : type}
  {...rest}
>
  <span><slot /></span>
</Tag>

<style>
  .acb {
    position: relative;
    box-sizing: border-box;
    display: inline-flex;
    padding: var(--inset-gap);
    border: 0;
    border-radius: 0;
    background: var(--o);
    cursor: pointer;
    font: var(--type-label);
    letter-spacing: 0.2px;
    text-decoration: none;
    color: var(--tx, var(--blue-500));
    height: var(--control-h);
    min-width: var(--control-min-w);
    transition: background var(--dur-fast) var(--ease-std);
    -webkit-font-smoothing: antialiased;
  }
  .acb > span {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    flex: 1;
    border-radius: var(--inner-radius);
    background: var(--i);
    padding: 0 16px;
    color: var(--tx, var(--blue-500));
    transition: background var(--dur-fast) var(--ease-std);
  }
  .acb:hover {
    background: var(--oh);
  }
  .acb:hover > span {
    background: var(--ih);
  }

  .acb-primary { --o: var(--blue-700); --i: var(--blue-100); --oh: var(--orange-500); --ih: var(--orange-100); }
  .acb-secondary { --o: var(--blue-300); --i: var(--blue-100); --oh: var(--orange-300); --ih: var(--orange-100); }
  .acb-ghost { --o: transparent; --i: transparent; --oh: var(--orange-500); --ih: var(--orange-100); --tx: var(--ac-ghost-ink, var(--blue-500)); }
  .acb-success { --o: var(--green-700); --i: var(--green-100); --oh: var(--green-300); --ih: var(--green-100); }
  .acb-warning { --o: var(--yellow-700); --i: var(--yellow-100); --oh: var(--yellow-300); --ih: var(--yellow-100); }
  .acb-danger { --o: var(--red-500); --i: var(--red-100); --oh: var(--red-300); --ih: var(--red-100); }
  .acb-dark-primary { --o: var(--blue-500); --i: var(--blue-900); --oh: var(--orange-500); --ih: var(--orange-700); --tx: var(--grey-50); }

  .acb-ghost,
  .acb-ghost > span { background: transparent; }
  .acb-sm { height: var(--control-h-sm); min-width: 0; }
  .acb-sm > span { padding: 0 14px; }
  .acb-block { display: flex; width: 100%; }
  .acb:focus-visible { outline: none; background: var(--oh); }
  .acb:focus-visible > span { background: var(--ih); box-shadow: 0 0 0 2px var(--oh) inset; }

  /* Dark mode — token swap only */
  :global([data-theme="dark"]) .acb-primary { --o: var(--blue-500); --i: var(--grey-50); --ih: var(--orange-50); }
  :global([data-theme="dark"]) .acb-secondary { --o: var(--blue-300); --i: var(--grey-50); --ih: var(--orange-50); }
  :global([data-theme="dark"]) .acb-ghost { --tx: var(--blue-50); --ih: var(--orange-50); }
  :global([data-theme="dark"]) .acb-ghost:hover,
  :global([data-theme="dark"]) .acb-ghost:focus-visible { --tx: var(--blue-900); }
</style>
