---
import { useTranslations } from "../i18n/utils";
import type { Locale } from "../i18n";
import Icon from "./icons/Icon.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<button
  type="button"
  class="acb-icon-toggle"
  data-theme-toggle
  aria-label={t.theme.toggle}
  title={t.theme.toggle}
>
  <span>
    <Icon name="IconsProductMediaSunStyleOutline" size={18} />
  </span>
</button>

<style>
  /* DS IconButton anatomy: ghost type — outer square frame + inner rounded fill.
     Rest = transparent; hover = copper frame + copper inner. */
  .acb-icon-toggle {
    position: relative;
    box-sizing: border-box;
    display: inline-flex;
    padding: var(--inset-gap);
    border: 0;
    border-radius: 0;
    background: transparent;
    cursor: pointer;
    width: var(--control-h-sm, 36px);
    height: var(--control-h-sm, 36px);
    transition: background var(--dur-fast) var(--ease-std);
  }
  .acb-icon-toggle > span {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    border-radius: var(--inner-radius);
    background: transparent;
    color: var(--text-muted);
    transition:
      background var(--dur-fast) var(--ease-std),
      color var(--dur-fast) var(--ease-std);
  }
  .acb-icon-toggle:hover {
    background: var(--orange-500);
  }
  .acb-icon-toggle:hover > span {
    background: var(--orange-100);
    color: var(--blue-900);
  }
  .acb-icon-toggle:focus-visible {
    outline: none;
    background: var(--orange-500);
  }
  .acb-icon-toggle:focus-visible > span {
    background: var(--orange-100);
    color: var(--blue-900);
    box-shadow: 0 0 0 2px var(--orange-500) inset;
  }
  :global([data-theme="dark"]) .acb-icon-toggle > span {
    color: var(--blue-50);
  }
  :global([data-theme="dark"]) .acb-icon-toggle:hover > span {
    background: var(--orange-50);
    color: var(--blue-900);
  }
</style>

<script>
  const KEY = "accartola-theme";
  document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const root = document.documentElement;
      const current =
        root.getAttribute("data-theme") ??
        (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
      const next = current === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      try {
        localStorage.setItem(KEY, next);
      } catch {
        /* storage unavailable — theme just won't persist */
      }
    });
  });
</script>
