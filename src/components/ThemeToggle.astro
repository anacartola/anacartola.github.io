---
import { useTranslations } from "../i18n/utils";
import type { Locale } from "../i18n";
import Icon from "./icons/Icon.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label={t.theme.toggle}
  title={t.theme.toggle}
>
  <Icon name="IconsProductMediaSunStyleOutline" size={16} />
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-h-tab, 32px);
    height: var(--control-h-tab, 32px);
    padding: 0;
    color: var(--text-muted);
    background: transparent;
    border: var(--stroke-default, 1px) solid var(--border-soft);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-std),
      border-color var(--dur-fast) var(--ease-std);
  }
  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    color: var(--frame-accent);
    border-color: var(--frame-accent);
  }
</style>

<script>
  const KEY = "accartola-theme";
  document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const root = document.documentElement;
      const current =
        root.getAttribute("data-theme") ??
        (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
      const next = current === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      try {
        localStorage.setItem(KEY, next);
      } catch {
        /* storage unavailable — theme just won't persist */
      }
    });
  });
</script>
