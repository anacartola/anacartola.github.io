---
import SuitIcon from "./symbols/SuitIcon.astro";

/**
 * Badge — DS anatomy: square outer + inner rounded (r4), 24px tall, uppercase
 * micro-label. API preserved: `suit` (colours + optional glyph), `label`, `icon`.
 * Plain badges (no suit) use the neutral pair.
 */
type Suit = "spades" | "diamonds" | "hearts" | "clubs" | "coringa";
interface Props {
  suit?: Suit;
  icon?: boolean;
  label: string;
  class?: string;
}
const { suit, icon = false, label, class: className } = Astro.props;
---

<span class:list={["acbadge", suit && "acbadge--suit", className]} data-suit={suit}>
  <span class="acbadge__inner">
    {suit && icon && <SuitIcon suit={suit} size={10} />}
    {label}
  </span>
</span>

<style>
  .acbadge {
    display: inline-flex;
    box-sizing: border-box;
    padding: 3px;
    height: 24px;
    border-radius: 0;
    background: var(--o, var(--blue-300));
    vertical-align: middle;
  }
  .acbadge__inner {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--i, var(--blue-50));
    border-radius: var(--radius-sm);
    padding: 0 8px;
    font: 600 10px/1 var(--font-body);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--blue-900);
    white-space: nowrap;
  }
  .acbadge--suit[data-suit="spades"] { --o: var(--blue-500); --i: var(--blue-50); }
  .acbadge--suit[data-suit="diamonds"] { --o: var(--yellow-700); --i: var(--yellow-100); }
  .acbadge--suit[data-suit="hearts"] { --o: var(--purple-500); --i: var(--purple-100); }
  .acbadge--suit[data-suit="clubs"] { --o: var(--orange-500); --i: var(--orange-100); }
</style>
