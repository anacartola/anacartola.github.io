---
import type { GetStaticPaths } from "astro";
import ProjectDetailPage from "../../../components/pages/ProjectDetailPage.astro";
import { getProjectSlugs } from "../../../lib/content";
import { SECONDARY_LOCALES, isLocale, DEFAULT_LOCALE } from "../../../i18n";

export const getStaticPaths = (async () => {
  const slugs = await getProjectSlugs();
  return SECONDARY_LOCALES.flatMap((lang) =>
    slugs.map((slug) => ({ params: { lang, slug } })),
  );
}) satisfies GetStaticPaths;

const { lang, slug } = Astro.params;
const locale = isLocale(lang) ? lang : DEFAULT_LOCALE;
---

<ProjectDetailPage locale={locale} slug={slug} />
